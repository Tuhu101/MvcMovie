<Window x:Class="WPFApp.MovieEdit"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WPFApp"
        mc:Ignorable="d"
        Title="MovieEdit" Height="450" Width="800">
    <Grid Margin="1,0,-1,0">
        <!-- Den her del er til mine textboxe. -->
        <TextBox x:Name="Rediger_Title" HorizontalAlignment="Left" Height="23" Margin="185,108,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="120"/>
        <TextBox x:Name="Rediger_ReleaseDate" HorizontalAlignment="Left" Height="23" Margin="185,138,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="120"/>
        <TextBox x:Name="Rediger_Genre" HorizontalAlignment="Left" Height="23" Margin="185,170,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="120"/>
        <TextBox x:Name="Rediger_Price" HorizontalAlignment="Left" Height="23" Margin="185,201,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="120" RenderTransformOrigin="0.522,-0.088"/>
        <TextBox x:Name="Rediger_Rating" HorizontalAlignment="Left" Height="23" Margin="185,232,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="120"/>
        <TextBox x:Name="Rediger_ID" HorizontalAlignment="Left" Height="23" Margin="455,108,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="120"/>

        <!-- Den her del er til mine label/etiketer. -->
        <Label Content="Title" HorizontalAlignment="Left" Margin="83,104,0,0" VerticalAlignment="Top"/>
        <Label Content="Release Data" HorizontalAlignment="Left" Margin="83,135,0,0" VerticalAlignment="Top" RenderTransformOrigin="0.59,1.377"/>
        <Label Content="Genre" HorizontalAlignment="Left" Margin="83,166,0,0" VerticalAlignment="Top"/>
        <Label Content="Price" HorizontalAlignment="Left" Margin="83,197,0,0" VerticalAlignment="Top" RenderTransformOrigin="0.72,0.89"/>
        <Label Content="Rating" HorizontalAlignment="Left" Margin="83,228,0,0" VerticalAlignment="Top"/>
        <Label Content="Rediger" HorizontalAlignment="Left" Margin="94,10,0,0" VerticalAlignment="Top" FontSize="50" Width="177"/>
        <Label Content="ID" HorizontalAlignment="Left" Margin="417,108,0,0" VerticalAlignment="Top"/>
        
        <!-- Cancel, OK og Rediger Knap. -->
        <Button Content="Cancel" HorizontalAlignment="Left" Margin="121,290,0,0" VerticalAlignment="Top" Width="75" Click="Button_Click"/>
        <Button Content="OK" HorizontalAlignment="Left" Margin="230,290,0,0" VerticalAlignment="Top" Width="75" RenderTransformOrigin="0.147,0.687" Click="Button_Click_1"/>
        <Button Content="Tilbage" HorizontalAlignment="Left" Margin="342,290,0,0" VerticalAlignment="Top" Width="75" Click="Button_Click_2"/>
    </Grid>
</Window>
